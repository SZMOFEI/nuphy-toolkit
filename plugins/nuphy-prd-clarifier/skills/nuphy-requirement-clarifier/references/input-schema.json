{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuphy.com/schemas/requirement-clarifier-input.schema.json",
  "title": "NuPhy requirement clarification input",
  "type": "object",
  "additionalProperties": false,
  "required": ["raw_request"],
  "properties": {
    "raw_request": {"type": "string", "minLength": 1},
    "requester_role": {"type": ["string", "null"]},
    "business_trigger": {"type": ["string", "null"]},
    "current_problem": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "expected_outcome": {"type": ["string", "null"]},
    "affected_users": {"type": "array", "items": {"type": "string"}},
    "affected_surfaces": {"type": "array", "items": {"type": "string"}},
    "markets_locales_devices": {"type": "array", "items": {"type": "string"}},
    "links": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "attachment_notes": {"type": "array", "items": {"type": "string"}},
    "target_date": {"type": ["string", "null"], "format": "date"},
    "deadline_reason": {"type": ["string", "null"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "requester_solution_suggestion": {"type": ["string", "null"]}
  }
}
